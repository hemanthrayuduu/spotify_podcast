# Production API URL - update with your Render API URL
REACT_APP_API_URL=https://spotify-podcast-recommender.onrender.com

# react-scripts 5 ships eslint-config-react-app, which references an older
# eslint-plugin-jest env ("jest/globals") that newer transitive versions no
# longer expose, breaking `npm run build`. Disable CRA's build-time ESLint
# plugin; linting is handled separately in CI.
DISABLE_ESLINT_PLUGIN=true
