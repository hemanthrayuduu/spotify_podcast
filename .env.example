# Groq API key for LLM-powered recommendations (open-weight gpt-oss model).
# Get one free at https://console.groq.com. If unset, the API falls back to
# a static list of recommendations.
GROQ_API_KEY=your_api_key_here

# Groq model used for recommendations (optional; defaults to openai/gpt-oss-120b).
# Check https://console.groq.com/docs/deprecations before pinning a model.
GROQ_MODEL=openai/gpt-oss-120b

# Comma-separated list of allowed browser origins for CORS.
# Set this to your deployed frontend URL in production.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Podcast Index key + secret (optional, free at https://api.podcastindex.org/signup).
# Used to find trending shows in the listener's language when Apple's charts
# have few (e.g. Telugu in the Indian store).
PODCASTINDEX_API_KEY=
PODCASTINDEX_API_SECRET=
