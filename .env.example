# Groq API key for LLM-powered recommendations (open-source Llama model).
# Get one free at https://console.groq.com. If unset, the API falls back to
# a static list of recommendations.
GROQ_API_KEY=your_api_key_here

# Groq model used for recommendations (optional; defaults to llama-3.3-70b-versatile).
GROQ_MODEL=llama-3.3-70b-versatile

# Comma-separated list of allowed browser origins for CORS.
# Set this to your deployed frontend URL in production.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
