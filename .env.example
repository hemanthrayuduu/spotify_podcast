# Anthropic API key for Claude-powered recommendations.
# If unset, the API falls back to a static list of recommendations.
ANTHROPIC_API_KEY=your_api_key_here

# Claude model used for recommendations (optional; defaults to claude-haiku-4-5).
ANTHROPIC_MODEL=claude-haiku-4-5

# Comma-separated list of allowed browser origins for CORS.
# Set this to your deployed frontend URL in production.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
